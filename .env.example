VITE_API_BASE_URL=https://fotbal-1.onrender.com
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Storage / persistence (solves the Render ephemeral-filesystem blocker)
# ---------------------------------------------------------------------------
# STORAGE_DRIVER=local        # "local" (Render Disk / dev folder) | "s3"
# PUBLIC_DIR=public/videos    # Where /videos is served+written. Point this at
#                             # your Render Disk mount, e.g. /var/data/videos
# MEDIA_RETENTION_HOURS=0     # Auto-purge generated files older than N hours (0 = off)

# --- S3-compatible object storage (AWS S3 / Cloudflare R2 / MinIO) ---
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=football-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://cdn.example.com
# S3_FORCE_PATH_STYLE=false
